{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "gcc 编译并运行",
      "type": "shell",
      "command": "gcc -std=c99 -o task task.c && ./task",
      "windows": {
        "command": "chcp 65001 >nul && gcc -std=c99 -finput-charset=UTF-8 -fexec-charset=UTF-8 -o task.exe task.c && task.exe",
        "options": {
          "shell": {
            "executable": "cmd.exe",
            "args": ["/c"]
          }
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}
